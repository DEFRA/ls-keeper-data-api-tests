# Target Service Base URLs
BRIDGE_BASE_URL=https://ephemeral-protected.api.dev.cdp-int.defra.cloud/ls-keeper-data-bridge-backend/
API_BASE_URL=https://ephemeral-protected.api.dev.cdp-int.defra.cloud/ls-keeper-data-api/

# Perimeter / Cloud Gateway Key (sent as x-api-key)
GATEWAY_API_KEY=your_gateway_api_key_here

# Keeper Data Bridge Ingest & Storage Access Key (sent as Authorization: ApiKey ...)
DATA_BRIDGE_API_KEY=your_data_bridge_api_key_here

# Keeper Data Consumer API Basic Auth Token (sent as Authorization: Basic ...)
KRDS_API_BASIC_AUTH=your_krds_api_basic_auth_base64_here

# Cryptographic Salt for PBKDF2 AES-256-ECB File Encryption
DECRYPTION_SALT=your_decryption_salt_here
